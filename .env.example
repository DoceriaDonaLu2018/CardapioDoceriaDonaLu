# Copie este arquivo para `.env` e ajuste os valores.

# Banco de dados PostgreSQL (Neon, Vercel Postgres, Supabase, etc.)
# Runtime (Vercel): pode ser a URL POOLED (host com "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Obrigatório para migrate no build (Neon): URL DIRETA sem "-pooler".
# No dashboard Neon: Connection string → "Direct" (não "Pooled").
# Se omitir e DATABASE_URL for pooled, o build pode falhar com P1002 (advisory lock).
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth / Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Credenciais do administrador (login do painel /admin)
ADMIN_EMAIL="admin@doceriadonalu.com"
ADMIN_PASSWORD="uma-senha-forte"

# Vercel Blob (upload de imagens dos produtos)
# Crie um Blob Store em Vercel > Storage e conecte ao projeto.
# Localmente: rode `vercel env pull .env` OU copie o token do dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# URL pública HTTPS do app (obrigatória para Checkout Pro: back_urls + webhooks)
# Ex.: https://cardapiodoceriadonalu.vercel.app — NÃO use localhost em produção
NEXT_PUBLIC_APP_URL="https://cardapiodoceriadonalu.vercel.app"

# --- Mercado Pago — Access Token NUNCA no frontend ---
# Checkout Pro: backend cria preferência; frontend renderiza Wallet Brick (SDK).
# Access Token (teste TEST-… ou produção APP_USR-…)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx"

# Public Key do MESMO modo do Access Token (TEST- com TEST-, APP_USR- com APP_USR-)
# Usada no frontend pelo MercadoPago.js / Wallet Brick
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx"

# Secret de validação de Webhooks (Your integrations > Webhooks > Configure)
# URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
# O mesmo webhook confirma Checkout Pro e PIX transparente.
MERCADOPAGO_WEBHOOK_SECRET="troque-pela-chave-secreta-do-webhook"

# Validade do QR PIX em minutos (mín. 30, máx. 43200 = 30 dias). Padrão: 30.
# MERCADOPAGO_PIX_EXPIRATION_MINUTES="30"
