// Prisma schema — Doceria Dona Lu
// Banco: PostgreSQL (funciona tanto localmente quanto na Vercel).
// A conexão vem da variável de ambiente DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([order])
}

model Product {
  id              String       @id @default(cuid())
  title           String
  description     String
  imageUrl        String
  price           Float
  costPrice       Float        @default(0)
  isAvailable     Boolean      @default(true)
  // Soft delete: produto some da vitrine/PDV, mas permanece no histórico de vendas.
  isDeleted       Boolean      @default(false)
  pricingStrategy String? // markupPercent | marginPercent | fixedProfit | finalPrice
  pricingValue    Float?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  recipeItems     RecipeItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId])
  @@index([isDeleted])
}

model Ingredient {
  id               String       @id @default(cuid())
  name             String       @unique
  purchasePrice    Float // custo da embalagem fechada
  purchaseQuantity Float // quantidade contida na embalagem
  unit             String // kg | g | mg | L | ml | un
  recipeItems      RecipeItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityUsed Float
  createdAt    DateTime   @default(now())

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model Order {
  id                 String      @id @default(cuid())
  customerName       String
  customerPhone      String? // WhatsApp da encomenda (opcional)
  customerEmail      String? // obrigatório no checkout online (payer PIX)
  waiterName         String?
  // State machine:
  // PDV: PENDING → COMPLETED | CANCELED
  // Online PIX: AWAITING_PAYMENT → PAID → COMPLETED | CANCELED
  // Cozinha NUNCA vê AWAITING_PAYMENT — só PENDING (balcão) e PAID (pago online).
  status             String      @default("PENDING")
  source             String      @default("PDV") // PDV | ONLINE
  totalAmount        Float
  advancePayment     Float       @default(0) // sinal pago antecipadamente (PDV)
  deliveryAddress    String?
  deliveryNotes      String?
  // Integração gateway (Mercado Pago PIX)
  paymentId          String?     @unique // ID do pagamento no gateway
  paymentProvider    String? // mercadopago
  paymentMethod      String? // pix
  pixCopyPaste       String?     @db.Text
  pixQrCodeBase64    String?     @db.Text
  // Token opaco para o cliente consultar status / ver QR sem login (não é secret do gateway).
  paymentAccessToken String?     @unique
  paidAt             DateTime?
  items              OrderItem[]
  createdAt          DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@map("orders")
}

/// Idempotência de webhooks: cada evento do gateway é processado no máximo uma vez.
model PaymentWebhookEvent {
  id        String   @id // ex.: "mp:payment:123456789" ou id da notificação
  paymentId String?
  orderId   String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
  @@map("payment_webhook_events")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Snapshot do título no momento da venda (histórico sobrevive a soft delete / rename).
  productTitle String  @default("")
  quantity     Int
  priceAtTime  Float
  costAtTime   Float   @default(0)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
